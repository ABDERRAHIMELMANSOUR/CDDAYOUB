
# ─── Cookieless analytics (ticket 24) ────────────────────────────────────────
# Leave unset and NO analytics script loads at all.
# Setting this enables Plausible, which sets no cookies and needs no consent
# banner under Telecommunicatiewet art. 11.7a. See src/lib/analytics.ts.
# VITE_PLAUSIBLE_DOMAIN=cddpaysbas.nl
#
# Only needed for a self-hosted instance (e.g. self-hosted Matomo/Plausible):
# VITE_PLAUSIBLE_HOST=https://analytics.cddpaysbas.nl

# ─── CRM webhook ─────────────────────────────────────────────────────────────
# Where Contact, membership application and event registration submissions are
# POSTed. Until this is set, forms tell the visitor CDD will be in touch but
# NOTHING IS RECORDED ANYWHERE — set it before launch. See src/lib/crm.ts.
#
# Must be an ingest-only endpoint: the URL ships in the public bundle, so it
# must not carry an API key and must not be able to read or export records.
# VITE_CRM_WEBHOOK_URL=https://hooks.example.com/cdd-website

# ─── LinkedIn feed ───────────────────────────────────────────────────────────
# JSON feed of posts from the CDD company page, produced SERVER-SIDE because
# LinkedIn's API requires an OAuth token that cannot ship in this bundle.
# Unset means the Insights page shows a link to the LinkedIn page instead of
# a post list. See src/lib/linkedin.ts for the two supported ways to produce it.
# VITE_LINKEDIN_FEED_URL=https://cddpaysbas.nl/api/linkedin

# ─── Form submissions ────────────────────────────────────────────────────────
# Forms POST to /api/submit (api/submit.ts), which emails them to the
# secretariat. These are SERVER-side variables — set them in Vercel, and note
# that none carries a VITE_ prefix, which is what keeps the API key out of the
# JavaScript bundle. A VITE_ prefixed secret is a public secret.
#
# RESEND_API_KEY is required. Without it the endpoint answers 503, the form
# tells the visitor CDD will be in touch, and nothing is silently lost.
RESEND_API_KEY=""
# Optional; these are the defaults.
CONTACT_TO="contact@cddpaysbas.nl"
CONTACT_FROM="CDD Pays-Bas <noreply@cddpaysbas.nl>"

# Optional. Set this only if CDD adopts a CRM: submissions then go there
# instead of to /api/submit, with no code change.
VITE_CRM_WEBHOOK_URL=""
